{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pribeh-worker",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "source \"$HOME/.nvm/nvm.sh\" >/dev/null 2>&1 && nvm use >/dev/null 2>&1; exec npx wrangler dev --port 8788"
      ],
      "port": 8788
    },
    {
      "name": "pribeh-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123"
      ],
      "port": 8123
    },
    {
      "name": "pribeh-mock",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/dev-server.py",
        "--port",
        "8124"
      ],
      "port": 8124
    },
    {
      "name": "pribeh-proxy",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/dev-server.py",
        "--proxy",
        "--port",
        "8125"
      ],
      "port": 8125
    }
  ]
}
